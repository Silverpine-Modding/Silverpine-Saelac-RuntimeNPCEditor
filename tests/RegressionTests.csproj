<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameRoot Condition="'$(GameRoot)' == ''">../../..</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../EditorDataRules.cs" Link="EditorDataRules.cs" />
    <Compile Include="../AtomicFile.cs" Link="AtomicFile.cs" />
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameRoot)/BepInEx/core/Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
